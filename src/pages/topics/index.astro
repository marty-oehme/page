---
import BlogSectionLayout from "../../layouts/BlogSectionLayout.astro";
import { getCollection } from "astro:content";

const publishedPosts = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true,
);

const topicCounts = new Map<string, number>();
for (const post of publishedPosts) {
  for (const topic of post.data.topics) {
    topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
  }
}

const topics = [...topicCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const formatTopic = (topic: string) => topic.replace(/-/g, " ");
---

<BlogSectionLayout title="Topics">
  <h2 class="mt-5 p-2 font-serif text-3xl text-primary">Topics</h2>
  <ul class="mt-4 flex flex-wrap gap-3 px-2">
    {
      topics.map(([topic, count]) => (
        <li>
          <a
            href={`/topics/${topic}`}
            class="inline-flex items-baseline gap-2 rounded-sm border border-base-300 bg-base-200 px-3 py-1 text-secondary transition-colors hover:border-secondary hover:bg-base-300"
          >
            <span>{formatTopic(topic)}</span>
            <span class="font-mono text-xs uppercase tracking-wide opacity-60">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BlogSectionLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import CollapsibleCard from "../components/CollapsibleCard.astro";

const pageTitle = "Projects";

import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
type ProjectEntry = CollectionEntry<"projects">;

const projects = await getCollection("projects");
const main_projects = projects.filter(
  (project: ProjectEntry) => project.data.status === "main",
);
const weekend_projects = projects.filter(
  (project: ProjectEntry) => project.data.status === "weekend",
);
const unmaintained_projects = projects.filter(
  (project: ProjectEntry) => project.data.status === "unmaintained",
);
---

<BaseLayout title={pageTitle}>
  <h2 class="mt-5 p-2 text-2xl text-primary md:text-4xl">{pageTitle}</h2>
  <article class="lg:m-8">
    {
      main_projects.map((project) => (
        <Card anchor={project.data.title}>
          <div slot="title">{project.data.title}</div>
          <div slot="subtitle">{project.data.subtitle}</div>
          <p>
            <Fragment set:html={project.data.description} />
          </p>
          {project.data.links ? (
            <div slot="button">
              {project.data.links.map((link) => (
                <Button href={link.url} variant={link.variant ? link.variant : "default"}>
                  {link.title}
                </Button>
              ))}
            </div>
          ) : (
            ""
          )}
        </Card>
      ))
    }
    <hr class="my-8" />
    <h2 class="text-2xl text-primary">Weekend projects</h2>

    <p>
      Smaller experiments and little tools which I reach for regularly, but which I do not
      actively promote or maintain as my main projects.
    </p>

    {
      weekend_projects.map((project) => (
        <CollapsibleCard anchor={project.data.title}>
          <div slot="title">{project.data.title}</div>
          <div slot="subtitle">{project.data.subtitle}</div>
          <p>
            <Fragment set:html={project.data.description} />
          </p>
          {project.data.links ? (
            <div slot="button">
              {project.data.links.map((link) => (
                <Button href={link.url} variant={link.variant ? link.variant : "default"}>
                  {link.title}
                </Button>
              ))}
            </div>
          ) : (
            ""
          )}
        </CollapsibleCard>
      ))
    }
    <hr class="my-8" />
    <h2 class="text-2xl text-primary">Unmaintained</h2>

    <p>
      Projects which have either reached a level of maturity that I am satisfied with or that are
      not longer the main focus of active open source maintenance efforts.
    </p>

    {
      unmaintained_projects.map((project) => (
        <CollapsibleCard anchor={project.data.title}>
          <div slot="title">{project.data.title}</div>
          <div slot="subtitle">{project.data.subtitle}</div>
          <p>
            <Fragment set:html={project.data.description} />
          </p>
          {project.data.links ? (
            <div slot="button">
              {project.data.links.map((link) => (
                <Button href={link.url} variant={link.variant ? link.variant : "default"}>
                  {link.title}
                </Button>
              ))}
            </div>
          ) : (
            ""
          )}
        </CollapsibleCard>
      ))
    }
  </article>
</BaseLayout>

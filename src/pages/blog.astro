---
import BlogSectionLayout from "../layouts/BlogSectionLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import SeriesPosts from "../components/SeriesPosts.astro";
import FeaturedPosts from "../components/FeaturedPosts.astro";
import { FEATURED_POST_IDS, FEATURED_POST_COUNT } from "../data/featured-posts";
import { getPublishedPosts, getSeriesName, type BlogEntry } from "../data/posts";

const pageTitle = "Writing";
const pageIntro =
  "Notes on Linux, developer tooling, self-hosting, programming, data, and assorted rabbit holes.";

const publishedPosts = await getPublishedPosts();
const featuredPosts = FEATURED_POST_IDS.map((id) => {
  const post = publishedPosts.find((entry: BlogEntry) => entry.id === id);
  if (!post) {
    throw new Error(`Featured blog post "${id}" was not found or is unpublished.`);
  }
  return post;
})
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, FEATURED_POST_COUNT);

// Topics are the curated taxonomy from the content schema; order them by how
// often they appear so the selector surfaces the busiest subjects first.
const topicCounts = new Map<string, number>();
for (const post of publishedPosts) {
  for (const topic of post.data.topics) {
    topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
  }
}
const topics = [...topicCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([topic]) => topic);
const formatTopic = (topic: string) => topic.replace(/-/g, " ");

// Keep Latest a bounded, recent-focus list: the newest entries only, with
// series anchored at their newest part. Anything older belongs to the full
// chronological archive (git-bug #229447d, #abc6c54) once that view exists.
const LATEST_MAX_ENTRIES = 20;

type LatestItem =
  | { kind: "post"; post: BlogEntry; date: Date }
  | { kind: "series"; name: string; posts: BlogEntry[]; date: Date };

// A series is one Latest entry, anchored at its newest currently published
// part. Its members are ordered by editorial series.order.
const postsBySeries = new Map<string, BlogEntry[]>();
const latestItems: LatestItem[] = [];
for (const post of publishedPosts) {
  const series = post.data.series;
  if (!series) {
    latestItems.push({ kind: "post", post, date: post.data.pubDate });
    continue;
  }

  const posts = postsBySeries.get(series.id) ?? [];
  posts.push(post);
  postsBySeries.set(series.id, posts);
}
for (const [id, posts] of postsBySeries) {
  latestItems.push({
    kind: "series",
    name: getSeriesName(posts, id),
    posts,
    date: new Date(Math.max(...posts.map((post) => post.data.pubDate.getTime()))),
  });
}

// Sort individual posts and series blocks together; a block's date is its
// newest currently published part's date.
const itemsByYear = latestItems
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, LATEST_MAX_ENTRIES)
  .reduce<Map<number, LatestItem[]>>((groups, item) => {
    const year = item.date.getFullYear();
    const items = groups.get(year) ?? [];
    items.push(item);
    groups.set(year, items);
    return groups;
  }, new Map());
const years = [...itemsByYear.keys()].sort((a, b) => b - a);
---

<BlogSectionLayout title={pageTitle}>
  <h2 class="mt-5 p-2 text-4xl text-primary">{pageTitle}</h2>
  <p class="px-2 text-secondary opacity-80">{pageIntro}</p>

  <FeaturedPosts posts={featuredPosts} />

  <section class="mt-8" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="p-2 font-serif text-3xl text-primary">Explore by topic</h2>
    <ul class="flex flex-wrap justify-between gap-x-6 gap-y-2 border-b border-base-300 px-2 pb-4">
      {
        topics.map((topic) => (
          <li>
            <a
              href={`/topics/${topic}`}
              class="text-secondary transition-colors hover:text-primary"
            >
              {formatTopic(topic)} <span aria-hidden="true" class="font-sans">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="latest mt-10" aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="p-2 font-serif text-3xl text-primary">Latest</h2>
    {
      years.map((year) => (
        <section class="mt-6" aria-labelledby={`year-${year}`}>
          <h3
            id={`year-${year}`}
            class="mb-1 border-b border-base-300 pb-1 font-mono text-sm uppercase tracking-widest text-secondary"
          >
            {year}
          </h3>
          <ul>
            {itemsByYear
              .get(year)!
              .map((item) =>
                item.kind === "series" ? (
                  <SeriesPosts name={item.name} posts={item.posts} />
                ) : (
                  <BlogPost url={`/blog/${item.post.id}`} post={item.post} />
                ),
              )}
          </ul>
        </section>
      ))
    }
  </section>
</BlogSectionLayout>

---
import BlogSectionLayout from "../layouts/BlogSectionLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import FeaturedPosts from "../components/FeaturedPosts.astro";
import Button from "../components/Button.astro";
import { FEATURED_POST_IDS, FEATURED_POST_COUNT } from "../data/featured-posts";

const pageTitle = "Writing";
const pageIntro =
  "Notes on Linux, developer tooling, self-hosting, programming, data, and assorted rabbit holes.";

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

// filter out drafts
const publishedPosts = await getCollection("blog", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const featuredPosts = FEATURED_POST_IDS.map((id) => {
  const post = publishedPosts.find((entry: BlogEntry) => entry.id === id);
  if (!post) {
    throw new Error(`Featured blog post "${id}" was not found or is unpublished.`);
  }
  return post;
})
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, FEATURED_POST_COUNT);
const allTags = [...new Set(publishedPosts.map((post: BlogEntry) => post.data.tags).flat())];

// Latest archive grouped by publication year, newest first within each year.
const postsByYear = [...publishedPosts]
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .reduce<Map<number, BlogEntry[]>>((groups, post) => {
    const year = post.data.pubDate.getFullYear();
    const posts = groups.get(year) ?? [];
    posts.push(post);
    groups.set(year, posts);
    return groups;
  }, new Map());
const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<BlogSectionLayout title={pageTitle}>
  <h2 class="mt-5 p-2 text-4xl text-primary">{pageTitle}</h2>
  <p class="px-2 text-secondary opacity-80">{pageIntro}</p>

  <FeaturedPosts posts={featuredPosts} />

  <section class="latest mt-10" aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="p-2 font-serif text-3xl text-primary">Latest</h2>
    {
      years.map((year) => (
        <section class="mt-6" aria-labelledby={`year-${year}`}>
          <h3
            id={`year-${year}`}
            class="mb-1 border-b border-base-300 pb-1 font-mono text-sm uppercase tracking-widest text-secondary"
          >
            {year}
          </h3>
          <ul>
            {postsByYear.get(year)!.map((post: BlogEntry) => (
              <BlogPost url={`/blog/${post.id}`} post={post} />
            ))}
          </ul>
        </section>
      ))
    }
  </section>
  <h2 class="p-2 text-xl text-secondary" id="tags">Tags</h2>
  <section class="tags flex flex-wrap justify-center space-x-2">
    {
      allTags.sort().map((tag) => (
        <Button variant="outline" href={`/tags/${tag}`}>
          <span class="m-2">{tag}</span>
        </Button>
      ))
    }
  </section>
</BlogSectionLayout>

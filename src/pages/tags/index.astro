---
import BlogSectionLayout from "../../layouts/BlogSectionLayout.astro";
import { getPublishedPosts } from "../../data/posts";

const publishedPosts = await getPublishedPosts();

const tagCounts = new Map<string, number>();
for (const post of publishedPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BlogSectionLayout title="Tags">
  <h2 class="mt-5 p-2 font-serif text-3xl text-primary">Tags</h2>
  <p class="px-2 text-secondary opacity-80">
    Finer-grained labels across the archive. For the curated subjects, see <a
      href="/topics"
      class="underline decoration-dotted underline-offset-2 hover:text-primary">topics</a
    >.
  </p>
  <ul class="mt-4 columns-1 gap-x-8 px-2 sm:columns-2 md:columns-3">
    {
      tags.map(([tag, count]) => (
        <li class="break-inside-avoid">
          <a
            href={`/tags/${tag}`}
            class="group flex items-baseline gap-1.5 py-1 text-secondary transition-colors hover:text-primary"
          >
            <span
              aria-hidden="true"
              class="font-mono text-sm opacity-40 transition group-hover:text-accent group-hover:opacity-100"
            >
              #
            </span>
            <span>{tag}</span>
            <span class="ml-auto font-mono text-xs uppercase tracking-wide opacity-60">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BlogSectionLayout>

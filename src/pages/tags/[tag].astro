---
import BlogSectionLayout from "../../layouts/BlogSectionLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import { getPublishedPosts, type BlogEntry } from "../../data/posts";

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BlogSectionLayout title={`Tag: ${tag}`}>
  <h2 class="mt-5 p-2 text-4xl text-primary">Tagged: {tag}</h2>
  <ul>
    {posts.map((post: BlogEntry) => <BlogPost url={`/blog/${post.id}`} post={post} />)}
  </ul>
</BlogSectionLayout>

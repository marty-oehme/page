---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  url: string;
  post: CollectionEntry<"blog">;
  showYear?: boolean;
  /** Optional series label, e.g. "Part 3" or "Interlude". */
  badge?: string;
}

const { url, post, showYear = false, badge } = Astro.props;

const { remarkPluginFrontmatter: rmData } = await render(post);

// need to use this version of data since it is scheme rendered by zod
const data = post.data;
const readingTime = rmData.readingTime;

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const date = `${data.pubDate.getDate()} ${MONTHS[data.pubDate.getMonth()]}${showYear ? ` ${data.pubDate.getFullYear()}` : ""}`;

// Only surface a couple of topics in the archive; the full set lives on the
// topic landing pages (#a417770).
const topics = data.topics.slice(0, 2);
const formatTopic = (topic: string) => topic.replace(/-/g, " ");
---

<li
  class="flex flex-col gap-1 border-b border-base-300 py-4 sm:flex-row sm:items-baseline sm:gap-6"
>
  <time
    datetime={data.pubDate.toISOString()}
    class:list={[
      "shrink-0 font-mono text-xs uppercase tracking-wide opacity-60",
      showYear ? "w-24" : "w-16",
    ]}
  >
    {date}
  </time>
  <div class="grow">
    {
      badge && (
        <span class="mr-2 font-mono text-xs uppercase tracking-wide text-accent">{badge}</span>
      )
    }
    <a href={url} class="font-serif text-lg leading-tight text-primary hover:text-primary-focus">
      {data.title}
    </a>
    <p class="mt-1 text-sm leading-snug opacity-70">{data.description}</p>
  </div>
  <div class="flex shrink-0 flex-col gap-1 sm:items-end">
    <span class="font-mono text-xs uppercase tracking-wide opacity-60">
      {readingTime}
    </span>
    {
      topics.length > 0 && (
        <span class="font-mono text-xs uppercase tracking-wide text-secondary">
          {topics.map((topic, index) => (
            <>
              {index > 0 && " · "}
              <a href={`/topics/${topic}`} class="hover:text-primary">
                {formatTopic(topic)}
              </a>
            </>
          ))}
        </span>
      )
    }
  </div>
</li>

---
import { render } from 'astro:content'

const { url, post } = Astro.props;

const { remarkPluginFrontmatter: rmData } = await render(post);

// need to use this version of data since it is scheme rendered by zod
const data = post.data;
data.readingTime = rmData.readingTime;

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const date = `${data.pubDate.getDate()} ${MONTHS[data.pubDate.getMonth()]}`;
---

<li
  class="flex flex-col gap-1 border-b border-base-300 py-4 sm:flex-row sm:items-baseline sm:gap-6"
>
  <time
    datetime={data.pubDate.toISOString()}
    class="w-16 shrink-0 font-mono text-xs uppercase tracking-wide opacity-60"
  >
    {date}
  </time>
  <div class="grow">
    <a href={url} class="font-serif text-lg leading-tight text-primary hover:text-primary-focus">
      {data.title}
    </a>
    <p class="mt-1 text-sm leading-snug opacity-70">{data.description}</p>
  </div>
  <span class="shrink-0 font-mono text-xs uppercase tracking-wide opacity-60 sm:text-right">
    {data.readingTime}
  </span>
</li>

---
import { NAVIGATION_LINKS } from "../data/constants";
import Logo from "./Logo.astro";
---

<div class="flex items-center justify-between border-b py-8">
  <Logo text="MO" />

  <nav class="">
    <input
      type="checkbox"
      id="mobile-menu-toggle"
      class="peer sr-only sm:hidden"
      aria-label="Open navigation menu"
    />
    <label
      for="mobile-menu-toggle"
      class="flex cursor-pointer px-4 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-primary sm:hidden"
    >
      <span class="hamburger space-y-2 hover:animate-pulse" aria-hidden="true">
        <span class="block h-0.5 w-8 bg-primary"></span>
        <span class="block h-0.5 w-8 bg-primary"></span>
        <span class="block h-0.5 w-8 bg-primary"></span>
      </span>
    </label>
    <div
      class="mobile-menu fixed inset-0 z-50 hidden overflow-y-auto overscroll-contain bg-menu px-8 py-8 text-menu-content"
    >
      <div class="flex justify-end">
        <label
          for="mobile-menu-toggle"
          class="closebutton h-8 w-8 cursor-pointer"
          aria-label="Close navigation menu"
        >
          <svg
            class="h-8 w-8"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </label>
      </div>

      <ul class="flex min-h-[150px] flex-col items-center justify-between">
        {
          NAVIGATION_LINKS.map((link) => (
            <li class="my-8 border-b border-primary uppercase hover:border-primary-focus">
              <a href={link.url}>{link.title}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="desktop-menu hidden px-4 sm:block">
      <ul class="justify flex flex-row items-center space-x-1">
        {
          NAVIGATION_LINKS.map((link) => (
            <a class="" href={link.url}>
              <li class="border-b border-accent px-1 py-2 uppercase hover:border-accent-focus hover:bg-accent-focus hover:text-accent-content">
                {link.title}
              </li>
            </a>
          ))
        }
      </ul>
    </div>
  </nav>
</div>

<style>
  /* CSS-only disclosure so the mobile menu works without JavaScript. */
  @media (max-width: 639px) {
    #mobile-menu-toggle:checked ~ .mobile-menu {
      display: block;
    }
  }
</style>

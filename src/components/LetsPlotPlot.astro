---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  id: string;
  spec: Record<string, any>;
  /** Static chart shown without JS, while loading, and on failure. */
  fallback: ImageMetadata;
  /** Accessible description of the chart. */
  alt: string;
}

const { id, spec, fallback, alt } = Astro.props;

if (!fallback) {
  throw new Error(`LetsPlotPlot "${id}" is missing a fallback image.`);
}

if (!alt) {
  throw new Error(`LetsPlotPlot "${id}" is missing alt text.`);
}
---

<figure class="plot" data-plot>
  {/* Eager: lazy images are not loaded when printing without scrolling. */}
  <a
    class="plot-link"
    href={fallback.src}
    target="_blank"
    rel="noopener"
    title="Open full-resolution image"
  >
    <Image
      src={fallback}
      alt={alt}
      class="plot-fallback"
      widths={[480, 704, 1024, 1408]}
      sizes="(min-width: 768px) 704px, 100vw"
      loading="eager"
      decoding="async"
    />
  </a>
  <div class="plot-target" aria-hidden="true">
    <div id={id}></div>
  </div>
</figure>

<script type="text/javascript" data-lets-plot-script="plot" define:vars={{ id, spec }} is:inline>
  (function () {
    // ----------

    const forceImmediateRender = false;
    const responsive = false;

    let sizing = {
      width_mode: "MIN",
      height_mode: "SCALED",
      width: null,
      height: null,
    };

    const preferredWidth = document.body.dataset.letsPlotPreferredWidth;
    if (preferredWidth !== undefined) {
      sizing = {
        width_mode: "FIXED",
        height_mode: "SCALED",
        width: parseFloat(preferredWidth),
      };
    }
    const containerDiv = document.getElementById(id);
    if (!containerDiv) {
      return;
    }
    const plot = containerDiv.closest("[data-plot]");
    let fig = null;

    function renderPlot() {
      if (fig === null) {
        const plotSpec = spec;
        window.letsPlotCall(function () {
          try {
            fig = LetsPlot.buildPlotFromProcessedSpecs(plotSpec, containerDiv, sizing);
            // Hide the static fallback only after the interactive figure exists.
            plot?.setAttribute("data-ready", "");
          } catch (error) {
            console.error("Could not render Lets-Plot figure", error);
          }
        });
      } else {
        fig.updateView({});
      }
    }

    const renderImmediately =
      forceImmediateRender ||
      (sizing.width_mode === "FIXED" &&
        (sizing.height_mode === "FIXED" || sizing.height_mode === "SCALED"));

    if (renderImmediately) {
      renderPlot();
    }

    if (!renderImmediately || responsive) {
      // Set up observer for initial sizing or continuous monitoring
      var observer = new ResizeObserver(function (entries) {
        for (let entry of entries) {
          if (entry.contentBoxSize && entry.contentBoxSize[0].inlineSize > 0) {
            if (!responsive && observer) {
              observer.disconnect();
              observer = null;
            }
            renderPlot();
            if (!responsive) {
              break;
            }
          }
        }
      });

      observer.observe(containerDiv);
    }

    // ----------
  })();
</script>

<style>
  .plot {
    position: relative;
    margin: 0;
  }

  .plot-link {
    display: block;
  }

  .plot-target {
    position: absolute;
    inset: 0;
    /* Let the static image stay clickable until the plot is ready. */
    pointer-events: none;
  }

  .plot[data-ready] .plot-target {
    pointer-events: auto;
  }

  .plot :global(.plot-fallback) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  /*
   * Keep the static image in flow (and in the accessibility tree) so the
   * interactive plot does not cause layout shift or lose its description.
   */
  .plot[data-ready] :global(.plot-fallback) {
    opacity: 0;
  }

  @media print {
    .plot-target {
      display: none !important;
    }

    .plot :global(.plot-fallback) {
      opacity: 1 !important;
    }
  }
</style>

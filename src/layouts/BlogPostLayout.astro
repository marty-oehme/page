---
import BlogSectionLayout from "./BlogSectionLayout.astro";
import { render, type CollectionEntry } from "astro:content";
import {
  formatDate,
  getPublishedPosts,
  getSeriesName,
  describeSeries,
} from "../data/posts";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { remarkPluginFrontmatter: rmFrontmatter } = await render(post);
const frontmatter = post.data;
const words = rmFrontmatter.words;
const readingTime = rmFrontmatter.readingTime;

// Series context: every published part of the same series, labelled in editorial
// series.order. Integer orders are main installments, fractional orders are
// interludes; `seriesIndex` locates this post in that sequence.
const series = frontmatter.series;
const seriesParts = series
  ? (await getPublishedPosts()).filter((entry) => entry.data.series?.id === series.id)
  : [];
const describedParts = describeSeries(seriesParts);
const seriesIndex = describedParts.findIndex((part) => part.entry.id === post.id);
const currentPart = seriesIndex >= 0 ? describedParts[seriesIndex] : undefined;
const mainCount = describedParts.filter((part) => part.partNumber !== null).length;
const seriesName = series ? getSeriesName(seriesParts, series.id) : "";
---

<BlogSectionLayout title={frontmatter.title} includePostsLink>
  <article class="prose mx-auto px-2 lg:px-8 lg:text-lg max-w-3xl font-serif">
    <section class="flex flex-col">
      <nav class="mt-4 flex justify-end" aria-label="Back to all posts">
        <a
          class="font-mono text-xs uppercase tracking-widest text-secondary transition-colors hover:text-primary"
          href="/blog"
        >
          <span aria-hidden="true" class="font-sans">&larr;</span> All posts
        </a>
      </nav>
      <h2 class="mt-4 font-serif text-4xl tracking-tight text-primary">{frontmatter.title}</h2>
      <p class="text-md text-secondary">{frontmatter.description}</p>
      {
        frontmatter.image && (
          <img src={frontmatter.image.url} width="100%" alt={frontmatter.image.alt} />
        )
      }
      <p class="mt-2 font-mono text-xs uppercase tracking-wide opacity-60">
        <time datetime={frontmatter.pubDate.toISOString()}>
          {formatDate(frontmatter.pubDate)}
        </time>
        <span aria-hidden="true"> · </span>
        {words} words<span aria-hidden="true"> · </span>
        {readingTime}
      </p>
    </section>

    {
      series && seriesIndex >= 0 && (
        <nav
          class="series not-prose my-4 border-l-4 border-accent bg-base-200 px-3 py-2 text-sm"
          aria-label="Series"
        >
          <p class="font-mono text-xs uppercase tracking-widest text-accent">
            {seriesName} &middot; {
              currentPart?.partNumber != null
                ? `Part ${currentPart.partNumber} of ${mainCount}`
                : "Interlude"
            }
          </p>
          <ol class="mt-1 space-y-0.5">
            {describedParts.map((part, index) =>
              index === seriesIndex ? (
                <li class="font-semibold">
                  {part.label}: {part.entry.data.title}
                </li>
              ) : (
                <li>
                  <a class="font-serif text-primary hover:text-primary-focus" href={`/blog/${part.entry.id}`}>
                    {part.label}: {part.entry.data.title}
                  </a>
                </li>
              ),
            )}
          </ol>
        </nav>
      )
    }

    <div class="border-t border-dashed">
      <slot />
    </div>

    <section
      class="tags mt-5 flex flex-wrap justify-end gap-x-3 font-mono text-xs uppercase tracking-wide text-secondary"
      aria-label="Tags"
    >
      {frontmatter.tags.map((tag: string) => <a class="hover:text-primary" href={`/tags/${tag}`}>{tag}</a>)}
    </section>

    {
      series && seriesIndex >= 0 && (
        <nav
          class="series-nav not-prose mt-8 flex justify-between gap-4 border-t border-dashed pt-4 text-sm"
          aria-label="Series navigation"
        >
          <div>
            {seriesIndex > 0 && (
              <a class="font-serif text-primary hover:text-primary-focus" href={`/blog/${describedParts[seriesIndex - 1].entry.id}`}>
                &larr; {describedParts[seriesIndex - 1].label}: {describedParts[seriesIndex - 1].entry.data.title}
              </a>
            )}
          </div>
          <div class="text-right">
            {seriesIndex >= 0 && seriesIndex < describedParts.length - 1 && (
              <a class="font-serif text-primary hover:text-primary-focus" href={`/blog/${describedParts[seriesIndex + 1].entry.id}`}>
                {describedParts[seriesIndex + 1].label}: {describedParts[seriesIndex + 1].entry.data.title} &rarr;
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</BlogSectionLayout>
